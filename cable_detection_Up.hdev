<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<l>dev_update_window ('on')</l>
<l>dev_update_pc ('on')</l>
<c></c>
<c>* =========================</c>
<c>* 参数</c>
<c>* =========================</c>
<l>WindowSize := 100</l>
<l>RowThresh := 10</l>
<c></c>
<c>* =========================</c>
<c>* Raw（真实数据）</c>
<c>* =========================</c>
<l>RowRawWindow := []</l>
<l>ColRawWindow := []</l>
<c></c>
<c>* =========================</c>
<c>* Ref（参考数据）</c>
<c>* =========================</c>
<l>RowRefWindow := []</l>
<l>ColRefWindow := []</l>
<c></c>
<c>* =========================</c>
<c>* 异常标记</c>
<c>* =========================</c>
<l>JumpFlag := []</l>
<c></c>
<c></c>
<l>for i := 1000 to 2000 by 1</l>
<c></c>
<l>    read_image (Image, 'E:/Data/Img/tunnel_Up/frame_' + i$'05d' + '.png')</l>
<c>    </c>
<c>    * --- 预处理 ---</c>
<l>    rgb1_to_gray (Image, GrayImage)</l>
<l>    scale_image_max (GrayImage, ImageScaled)</l>
<l>    full_domain (ImageScaled, ImageScaled)</l>
<c></c>
<l>    threshold (ImageScaled, Region, 128, 255)</l>
<l>    dilation_rectangle1 (Region, RegionDilation, 15, 15)</l>
<l>    erosion_circle (RegionDilation, RegionErosion, 7)</l>
<c></c>
<l>    connection (RegionErosion, ConnectedRegions)</l>
<l>    select_shape (ConnectedRegions, RegionSelected, 'area', 'and', 45, 200)</l>
<c></c>
<l>    count_obj (RegionSelected, Num)</l>
<c></c>
<c>    * --- 初始化 ---</c>
<l>    gen_empty_obj (TargetRegions)</l>
<l>    RowResult := -1</l>
<l>    ColResult := -1</l>
<c></c>
<l>    if (Num &lt; 1)</l>
<l>        continue</l>
<l>    endif</l>
<c></c>
<c>    * =========================</c>
<c>    * 情况1：只有一个色块</c>
<c>    * =========================</c>
<l>    if (Num == 1)</l>
<c></c>
<l>        select_obj (RegionSelected, R1, 1)</l>
<l>        smallest_rectangle1 (R1, Row1_min, Col1_min, Row1_max, Col1_max)</l>
<c></c>
<l>        RowResult := Row1_max</l>
<l>        ColResult := (Col1_min + Col1_max)/2</l>
<l>        TargetRegions := R1</l>
<c></c>
<c>    * =========================</c>
<c>    * 情况2：多个色块（优化版本）</c>
<c>    * =========================</c>
<l>    else</l>
<c>        * --- 获取中心点 ---</c>
<l>        area_center (RegionSelected, _, CenterRows, CenterCols)</l>
<l>        NumRegions := |CenterRows|</l>
<c>        </c>
<c>        * --- 按列排序 ---</c>
<l>        tuple_sort_index (CenterCols, SortedIdx)</l>
<l>        SortedRows := CenterRows[SortedIdx]</l>
<l>        SortedCols := CenterCols[SortedIdx]</l>
<c>        </c>
<c>        * --- 标记是否已使用 ---</c>
<l>        IsUsed := gen_tuple_const(NumRegions, 0)</l>
<c>        </c>
<c>        * --- 成对结果 ---</c>
<l>        PairedIndices := []</l>
<c>        </c>
<c>        * =========================</c>
<c>        * Step1：邻近配对</c>
<c>        * =========================</c>
<l>        for idxSorted := 0 to NumRegions-2 by 1</l>
<c>        </c>
<l>            if (IsUsed[idxSorted] == 0 and IsUsed[idxSorted+1] == 0)</l>
<c>        </c>
<l>                dCol := abs(SortedCols[idxSorted] - SortedCols[idxSorted+1])</l>
<l>                dRow := abs(SortedRows[idxSorted] - SortedRows[idxSorted+1])</l>
<c>        </c>
<l>                if (dCol &lt;= 200 and dRow &lt;= 10)</l>
<c>        </c>
<l>                    regionIdxA := SortedIdx[idxSorted] + 1</l>
<l>                    regionIdxB := SortedIdx[idxSorted+1] + 1</l>
<c>        </c>
<l>                    PairedIndices := [PairedIndices, regionIdxA, regionIdxB]</l>
<c>        </c>
<l>                    IsUsed[idxSorted] := 1</l>
<l>                    IsUsed[idxSorted+1] := 1</l>
<l>                endif</l>
<c>        </c>
<l>            endif</l>
<c>        </c>
<l>        endfor</l>
<c>        </c>
<c>        * =========================</c>
<c>        * Step2：没有配对</c>
<c>        * =========================</c>
<l>        if (|PairedIndices| == 0)</l>
<l>            gen_empty_obj(TargetRegions)</l>
<l>            RowResult := -1</l>
<l>            ColResult := -1</l>
<c>        </c>
<l>        else</l>
<c>        </c>
<c>            * =========================</c>
<c>            * Step3：找最低的一组</c>
<c>            * =========================</c>
<l>            GroupCount := |PairedIndices| / 2</l>
<c>        </c>
<l>            BestGroupBottom := -1</l>
<l>            BestGroupIdx := -1</l>
<c>        </c>
<l>            for groupIdx := 0 to GroupCount-1 by 1</l>
<c>        </c>
<l>                regionIdxA := PairedIndices[2*groupIdx]</l>
<l>                regionIdxB := PairedIndices[2*groupIdx+1]</l>
<c>        </c>
<l>                select_obj (RegionSelected, RegionA, regionIdxA)</l>
<l>                select_obj (RegionSelected, RegionB, regionIdxB)</l>
<c>        </c>
<l>                concat_obj (RegionA, RegionB, GroupRegion)</l>
<c>        </c>
<l>                smallest_rectangle1 (GroupRegion, _, _, RowMaxG, _)</l>
<c>        </c>
<l>                if (RowMaxG &gt; BestGroupBottom)</l>
<l>                    BestGroupBottom := RowMaxG</l>
<l>                    BestGroupIdx := groupIdx</l>
<l>                endif</l>
<c>        </c>
<l>            endfor</l>
<c>        </c>
<c>            * =========================</c>
<c>            * Step4：输出最终组</c>
<c>            * =========================</c>
<l>            regionIdxA := PairedIndices[2*BestGroupIdx]</l>
<l>            regionIdxB := PairedIndices[2*BestGroupIdx+1]</l>
<c>        </c>
<l>            select_obj (RegionSelected, RegionA, regionIdxA)</l>
<l>            select_obj (RegionSelected, RegionB, regionIdxB)</l>
<c>        </c>
<l>            concat_obj (RegionA, RegionB, FinalGroup)</l>
<c>        </c>
<l>            TargetRegions := FinalGroup</l>
<c>        </c>
<c>            * --- 输出中心点 ---</c>
<l>            area_center (FinalGroup, _, RowsF, ColsF)</l>
<l>            tuple_mean (RowsF, RowResult)</l>
<l>            tuple_mean (ColsF, ColResult)</l>
<c>            </c>
<c>            * =========================</c>
<c>            * Step1：记录 Raw（始终记录）</c>
<c>            * =========================</c>
<l>            RowRawWindow := [RowRawWindow, RowResult]</l>
<l>            ColRawWindow := [ColRawWindow, ColResult]</l>
<c>            </c>
<l>            RawLen := |RowRawWindow|</l>
<l>            RefLen := |RowRefWindow|</l>
<c>            </c>
<c>            * =========================</c>
<c>            * Step2：前几帧直接作为参考</c>
<c>            * =========================</c>
<l>            if (RefLen &lt; 3)</l>
<c>                </c>
<l>                RowRefWindow := [RowRefWindow, RowResult]</l>
<l>                ColRefWindow := [ColRefWindow, ColResult]</l>
<l>                JumpFlag := [JumpFlag, 0]</l>
<c>            </c>
<l>            else</l>
<c>            </c>
<c>                * =========================</c>
<c>                * Step3：无效值保护</c>
<c>                * =========================</c>
<l>                if (RowResult == -1 or ColResult == -1)</l>
<c>                    </c>
<c>                    * Raw 已记录</c>
<c>                    * Ref 用上一帧（不污染）</c>
<l>                    PrevRow := RowRefWindow[RefLen-1]</l>
<l>                    PrevCol := ColRefWindow[RefLen-1]</l>
<c>                    </c>
<l>                    RowRefWindow := [RowRefWindow, PrevRow]</l>
<l>                    ColRefWindow := [ColRefWindow, PrevCol]</l>
<l>                    JumpFlag := [JumpFlag, 1]</l>
<c>            </c>
<l>                else</l>
<c>                    </c>
<c>                    * =========================</c>
<c>                    * Step4：取 Ref 最近3帧</c>
<c>                    * =========================</c>
<l>                    LastRefRows := RowRefWindow[RefLen-3:RefLen-1]</l>
<c>            </c>
<c>                    * 检查历史是否有无效值</c>
<l>                    tuple_find(LastRefRows, -1, InvalidIdx)</l>
<c>            </c>
<l>                    if (InvalidIdx != -1)</l>
<c>                        </c>
<c>                        * 不做判断，直接加入</c>
<l>                        RowRefWindow := [RowRefWindow, RowResult]</l>
<l>                        ColRefWindow := [ColRefWindow, ColResult]</l>
<l>                        JumpFlag := [JumpFlag, 0]</l>
<c>            </c>
<l>                    else</l>
<c>                        </c>
<c>                        * =========================</c>
<c>                        * Step5：计算均值</c>
<c>                        * =========================</c>
<l>                        tuple_mean(LastRefRows, RowMean)</l>
<c>            </c>
<c>                        * =========================</c>
<c>                        * Step6：计算差值（只看Row）</c>
<c>                        * =========================</c>
<l>                        dRow := abs(RowResult - RowMean)</l>
<c>            </c>
<c>                        * =========================</c>
<c>                        * Step7：跳变判断</c>
<c>                        * =========================</c>
<l>                        if (dRow &gt; RowThresh)</l>
<c>                            </c>
<c>                            * -------- 异常 --------</c>
<l>                            PrevRow := RowRefWindow[RefLen-1]</l>
<l>                            PrevCol := ColRefWindow[RefLen-1]</l>
<c>                            </c>
<l>                            RowRefWindow := [RowRefWindow, PrevRow]</l>
<l>                            ColRefWindow := [ColRefWindow, PrevCol]</l>
<c>                            </c>
<l>                            JumpFlag := [JumpFlag, 1]</l>
<c>            </c>
<l>                        else</l>
<c>                            </c>
<c>                            * -------- 正常 --------</c>
<l>                            RowRefWindow := [RowRefWindow, RowResult]</l>
<l>                            ColRefWindow := [ColRefWindow, ColResult]</l>
<c>                            </c>
<l>                            JumpFlag := [JumpFlag, 0]</l>
<c>            </c>
<l>                        endif</l>
<c>            </c>
<l>                    endif</l>
<c>            </c>
<l>                endif</l>
<c>            </c>
<l>            endif</l>
<c>            </c>
<c>            * =========================</c>
<c>            * Step8：滑动窗口裁剪</c>
<c>            * =========================</c>
<l>            RawLen := |RowRawWindow|</l>
<c></c>
<l>            if (RawLen &gt; 3000)</l>
<l>                RowRawWindow := RowRawWindow[1:RawLen-1]</l>
<l>                ColRawWindow := ColRawWindow[1:RawLen-1]</l>
<l>                JumpFlag := JumpFlag[1:RawLen-1]</l>
<l>            endif</l>
<c>            </c>
<l>            RefLen := |RowRefWindow|</l>
<c>            </c>
<l>            if (RefLen &gt; 100)</l>
<l>                RowRefWindow := RowRefWindow[1:RefLen-1]</l>
<l>                ColRefWindow := ColRefWindow[1:RefLen-1]</l>
<l>            endif</l>
<c>        </c>
<l>        endif</l>
<c></c>
<l>    endif</l>
<c></c>
<c>    * =========================</c>
<c>    * 显示（安全）</c>
<c>    * =========================</c>
<l>    dev_clear_window ()</l>
<l>    dev_display (ImageScaled)</l>
<c></c>
<l>    count_obj (TargetRegions, NumTarget)</l>
<l>    if (NumTarget &gt; 0)</l>
<l>        dev_set_color ('red')</l>
<l>        dev_display (TargetRegions)</l>
<l>    endif</l>
<c></c>
<l>    if (RowResult != -1 and ColResult != -1)</l>
<c></c>
<l>        tuple_select (RowResult, 0, RowNum)</l>
<l>        tuple_select (ColResult, 0, ColNum)</l>
<c></c>
<l>        gen_rectangle1 (Cross, RowNum-5, ColNum-5, RowNum+5, ColNum+5)</l>
<c></c>
<l>        dev_set_color ('green')</l>
<l>        dev_display (Cross)</l>
<l>    endif</l>
<c></c>
<l>endfor</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
