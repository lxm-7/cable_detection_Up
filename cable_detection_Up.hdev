<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* ============================================================</c>
<c>* 主流程：逐帧处理图像</c>
<c>* ============================================================</c>
<c></c>
<l>dev_update_window('on')</l>
<l>dev_update_pc('on')</l>
<c></c>
<c>* ============================================================</c>
<c>* 参数</c>
<c>* ============================================================</c>
<l>WindowSize := 100</l>
<l>RowThresh := 10</l>
<c></c>
<c>* ============================================================</c>
<c>* 缓存</c>
<c>* ============================================================</c>
<l>RowRawWindow := []</l>
<l>ColRawWindow := []</l>
<c></c>
<l>RowRefWindow := []</l>
<l>ColRefWindow := []</l>
<c></c>
<l>JumpFlag := []</l>
<c></c>
<c>* ============================================================</c>
<c>* 主循环</c>
<c>* ============================================================</c>
<l>for FrameIndex := 1120 to 1220 by 1</l>
<c></c>
<l>    read_image(Image, 'E:/Data/Img/tunnel_Up/frame_' + FrameIndex$'05d' + '.png')</l>
<c></c>
<l>    rgb1_to_gray(Image, GrayImage)</l>
<l>    scale_image_max(GrayImage, ImageScaled)</l>
<l>    full_domain(ImageScaled, ImageScaled)</l>
<c></c>
<l>    threshold(ImageScaled, Region, 128, 255)</l>
<l>    dilation_rectangle1(Region, RegionDilation, 15, 15)</l>
<l>    erosion_circle(RegionDilation, RegionErosion, 7)</l>
<c></c>
<l>    connection(RegionErosion, ConnectedRegions)</l>
<l>    select_shape(ConnectedRegions, RegionSelected, 'area', 'and', 45, 150)</l>
<c></c>
<l>    count_obj(RegionSelected, RegionCount)</l>
<c></c>
<l>    gen_empty_obj(TargetRegions)</l>
<l>    RowResult := -1</l>
<l>    ColResult := -1</l>
<c></c>
<l>    if (RegionCount &lt; 1)</l>
<l>        continue</l>
<l>    endif</l>
<c></c>
<c>    * ============================================================</c>
<c>    * 单区域</c>
<c>    * ============================================================</c>
<l>    if (RegionCount == 1)</l>
<c></c>
<l>        select_obj(RegionSelected, SingleRegion, 1)</l>
<l>        smallest_rectangle1(SingleRegion, RowMin, ColMin, RowMax, ColMax)</l>
<c></c>
<l>        RowResult := RowMax</l>
<l>        ColResult := (ColMin + ColMax) / 2</l>
<l>        TargetRegions := SingleRegion</l>
<c></c>
<l>    else</l>
<c></c>
<c>        * ============================================================</c>
<c>        * Step0：形状过滤</c>
<c>        * ============================================================</c>
<l>        gen_empty_obj(RegionFiltered)</l>
<c></c>
<l>        for RegionIndex := 1 to RegionCount by 1</l>
<c></c>
<l>            select_obj(RegionSelected, CurrentRegion, RegionIndex)</l>
<c></c>
<l>            smallest_rectangle1(CurrentRegion, Row1, Col1, Row2, Col2)</l>
<c></c>
<l>            Width := Col2 - Col1</l>
<l>            Height := Row2 - Row1</l>
<c></c>
<l>            if (Height &lt;= 0)</l>
<l>                continue</l>
<l>            endif</l>
<c></c>
<l>            AspectRatio := Width / Height</l>
<c></c>
<l>            if (AspectRatio &gt; 2.5)</l>
<l>                concat_obj(RegionFiltered, CurrentRegion, RegionFiltered)</l>
<l>            endif</l>
<c></c>
<l>        endfor</l>
<c></c>
<l>        count_obj(RegionFiltered, FilteredCount)</l>
<c></c>
<l>        if (FilteredCount &lt; 2)</l>
<l>            continue</l>
<l>        endif</l>
<c></c>
<c>        * ============================================================</c>
<c>        * ⚠️ 关键修复：过滤后重新计算中心</c>
<c>        * ============================================================</c>
<l>        area_center(RegionFiltered, _, CenterRows, CenterCols)</l>
<c></c>
<l>        tuple_sort_index(CenterCols, SortedIndex)</l>
<c></c>
<l>        SortedRows := CenterRows[SortedIndex]</l>
<l>        SortedCols := CenterCols[SortedIndex]</l>
<c></c>
<l>        IsUsed := gen_tuple_const(FilteredCount, 0)</l>
<l>        PairedIndices := []</l>
<c></c>
<c>        * ============================================================</c>
<c>        * Step1：配对</c>
<c>        * ============================================================</c>
<l>        SearchWindowSize := 5</l>
<c></c>
<l>        for CurrentIndex := 0 to FilteredCount - 1 by 1</l>
<c></c>
<l>            if (IsUsed[CurrentIndex] == 1)</l>
<l>                continue</l>
<l>            endif</l>
<c></c>
<l>            BestMatchIndex := -1</l>
<l>            BestDistance := 1e10</l>
<c></c>
<l>            RightLimit := CurrentIndex + SearchWindowSize</l>
<l>            if (RightLimit &gt; FilteredCount - 1)</l>
<l>                RightLimit := FilteredCount - 1</l>
<l>            endif</l>
<c></c>
<l>            for CandidateIndex := CurrentIndex + 1 to RightLimit by 1</l>
<c></c>
<l>                if (IsUsed[CandidateIndex] == 1)</l>
<l>                    continue</l>
<l>                endif</l>
<c></c>
<l>                dCol := abs(SortedCols[CurrentIndex] - SortedCols[CandidateIndex])</l>
<l>                dRow := abs(SortedRows[CurrentIndex] - SortedRows[CandidateIndex])</l>
<c></c>
<l>                if (dCol &lt;= 80 and dRow &lt;= 3)</l>
<c></c>
<l>                    DistanceScore := dCol + dRow * 2</l>
<c></c>
<l>                    if (DistanceScore &lt; BestDistance)</l>
<l>                        BestDistance := DistanceScore</l>
<l>                        BestMatchIndex := CandidateIndex</l>
<l>                    endif</l>
<c></c>
<l>                endif</l>
<c></c>
<l>            endfor</l>
<c></c>
<l>            LeftLimit := CurrentIndex - SearchWindowSize</l>
<l>            if (LeftLimit &lt; 0)</l>
<l>                LeftLimit := 0</l>
<l>            endif</l>
<c></c>
<l>            for CandidateIndex := LeftLimit to CurrentIndex - 1 by 1</l>
<c></c>
<l>                if (IsUsed[CandidateIndex] == 1)</l>
<l>                    continue</l>
<l>                endif</l>
<c></c>
<l>                dCol := abs(SortedCols[CurrentIndex] - SortedCols[CandidateIndex])</l>
<l>                dRow := abs(SortedRows[CurrentIndex] - SortedRows[CandidateIndex])</l>
<c></c>
<l>                if (dCol &lt;= 80 and dRow &lt;= 3)</l>
<c></c>
<l>                    DistanceScore := dCol + dRow * 2</l>
<c></c>
<l>                    if (DistanceScore &lt; BestDistance)</l>
<l>                        BestDistance := DistanceScore</l>
<l>                        BestMatchIndex := CandidateIndex</l>
<l>                    endif</l>
<c></c>
<l>                endif</l>
<c></c>
<l>            endfor</l>
<c></c>
<l>            if (BestMatchIndex != -1)</l>
<c></c>
<l>                regionIdxA := SortedIndex[CurrentIndex] + 1</l>
<l>                regionIdxB := SortedIndex[BestMatchIndex] + 1</l>
<c></c>
<l>                PairedIndices := [PairedIndices, regionIdxA, regionIdxB]</l>
<c></c>
<l>                IsUsed[CurrentIndex] := 1</l>
<l>                IsUsed[BestMatchIndex] := 1</l>
<c></c>
<l>            endif</l>
<c></c>
<l>        endfor</l>
<c></c>
<c>        * ============================================================</c>
<c>        * Step2：无配对</c>
<c>        * ============================================================</c>
<l>        if (|PairedIndices| == 0)</l>
<l>            continue</l>
<l>        endif</l>
<c></c>
<c>        * ============================================================</c>
<c>        * Step3：选最优组</c>
<c>        * ============================================================</c>
<l>        GroupCount := |PairedIndices| / 2</l>
<c></c>
<l>        BestScore := 1e10</l>
<l>        gen_empty_obj(BestRegionA)</l>
<l>        gen_empty_obj(BestRegionB)</l>
<c></c>
<l>        for GroupIndex := 0 to GroupCount - 1 by 1</l>
<c></c>
<l>            regionIdxA := PairedIndices[2 * GroupIndex]</l>
<l>            regionIdxB := PairedIndices[2 * GroupIndex + 1]</l>
<c></c>
<l>            select_obj(RegionFiltered, RegionA, regionIdxA)</l>
<l>            select_obj(RegionFiltered, RegionB, regionIdxB)</l>
<c></c>
<l>            concat_obj(RegionA, RegionB, GroupRegion)</l>
<c></c>
<l>            area_center(GroupRegion, _, RowG, ColG)</l>
<l>            smallest_rectangle1(GroupRegion, _, _, RowMaxG, _)</l>
<c></c>
<l>            Score := -RowMaxG</l>
<c></c>
<l>            if (Score &lt; BestScore)</l>
<l>                BestScore := Score</l>
<l>                BestRegionA := RegionA</l>
<l>                BestRegionB := RegionB</l>
<l>            endif</l>
<c></c>
<l>        endfor</l>
<c></c>
<l>        concat_obj(BestRegionA, BestRegionB, TargetRegions)</l>
<c></c>
<l>        area_center(BestRegionA, _, RowA, ColA)</l>
<l>        area_center(BestRegionB, _, RowB, ColB)</l>
<c></c>
<l>        RowResult := (RowA + RowB) / 2</l>
<l>        ColResult := (ColA + ColB) / 2</l>
<c>        </c>
<c>        * ============================================================</c>
<c>        * Step4：Raw记录（始终记录，不做任何判断）</c>
<c>        * ============================================================</c>
<c>        </c>
<l>        RowRawWindow := [RowRawWindow, RowResult]</l>
<l>        ColRawWindow := [ColRawWindow, ColResult]</l>
<c>        </c>
<l>        RawLen := |RowRawWindow|</l>
<l>        RefLen := |RowRefWindow|</l>
<c>        </c>
<c>        </c>
<c>        * ============================================================</c>
<c>        * Step5：Ref更新（预测 + 修正）</c>
<c>        * ============================================================</c>
<c>        </c>
<l>        if (RefLen &lt; 2)</l>
<c>        </c>
<c>            * 前两帧直接使用检测值</c>
<l>            RowRefWindow := [RowRefWindow, RowResult]</l>
<l>            ColRefWindow := [ColRefWindow, ColResult]</l>
<l>            JumpFlag := [JumpFlag, 0]</l>
<c>        </c>
<l>        else</l>
<c>        </c>
<l>            LastRow := RowRefWindow[RefLen - 1]</l>
<l>            LastCol := ColRefWindow[RefLen - 1]</l>
<c>        </c>
<l>            PrevRow := RowRefWindow[RefLen - 2]</l>
<l>            PrevCol := ColRefWindow[RefLen - 2]</l>
<c>        </c>
<c>            * 行方向误差</c>
<l>            dRow := abs(RowResult - LastRow)</l>
<c>        </c>
<l>            if (RowResult == -1 or dRow &gt; RowThresh)</l>
<c>        </c>
<c>                * ----------------------------</c>
<c>                * 异常：使用预测值（匀速模型）</c>
<c>                * ----------------------------</c>
<l>                PredRow := LastRow + (LastRow - PrevRow)</l>
<l>                PredCol := LastCol + (LastCol - PrevCol)</l>
<c>        </c>
<l>                RowRefWindow := [RowRefWindow, PredRow]</l>
<l>                ColRefWindow := [ColRefWindow, PredCol]</l>
<c>        </c>
<l>                JumpFlag := [JumpFlag, 1]</l>
<c>        </c>
<l>            else</l>
<c>        </c>
<c>                * ----------------------------</c>
<c>                * 正常：使用当前检测值</c>
<c>                * ----------------------------</c>
<l>                RowRefWindow := [RowRefWindow, RowResult]</l>
<l>                ColRefWindow := [ColRefWindow, ColResult]</l>
<c>        </c>
<l>                JumpFlag := [JumpFlag, 0]</l>
<c>        </c>
<l>            endif</l>
<c>        </c>
<l>        endif</l>
<c>        </c>
<c>        </c>
<c>        * ============================================================</c>
<c>        * Step6：滑动窗口裁剪</c>
<c>        * ============================================================</c>
<c>        </c>
<l>        if (|RowRawWindow| &gt; 3000)</l>
<l>            RowRawWindow := RowRawWindow[1:|RowRawWindow|-1]</l>
<l>            ColRawWindow := ColRawWindow[1:|ColRawWindow|-1]</l>
<l>            JumpFlag := JumpFlag[1:|JumpFlag|-1]</l>
<l>        endif</l>
<c>        </c>
<l>        if (|RowRefWindow| &gt; 100)</l>
<l>            RowRefWindow := RowRefWindow[1:|RowRefWindow|-1]</l>
<l>            ColRefWindow := ColRefWindow[1:|ColRefWindow|-1]</l>
<l>        endif</l>
<c></c>
<l>    endif</l>
<c></c>
<c>    </c>
<c>    * ============================================================</c>
<c>    * 显示</c>
<c>    * ============================================================</c>
<l>    dev_clear_window()</l>
<l>    dev_display(ImageScaled)</l>
<c></c>
<l>    if (RowResult != -1)</l>
<l>        gen_rectangle1(Cross, RowResult - 5, ColResult - 5, RowResult + 5, ColResult + 5)</l>
<l>        dev_set_color('green')</l>
<l>        dev_display(Cross)</l>
<l>    endif</l>
<c></c>
<l>endfor</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
